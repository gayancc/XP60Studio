{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XPPatchStudio",
  "version": "0.1.0-alpha.1",
  "identifier": "studio.xppatch.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "XPPatchStudio",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "XPPatchStudio",
    "shortDescription": "Roland XP-60 patch editor and librarian",
    "longDescription": "XPPatchStudio edits, organises and backs up Roland XP-60 patches, performances, rhythm sets and system settings, and sends them to the instrument over MIDI.",
    "category": "Music",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "startMenuFolder": "XPPatchStudio"
      }
    }
  }
}
